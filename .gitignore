# ══════════════════════════════════════════════════════════════
#  BBDown GUI —— 仓库级忽略规则
#  子目录另有 BBDown-Native/.gitignore（层级更深、优先级更高）
# ══════════════════════════════════════════════════════════════

# ── 敏感凭据 —— 绝对不得入库 ──
#  config.json / BBDown.data / BBDownTV.data 内含 B 站 SESSDATA
#  cookie 与 access_token，一旦公开等同于账号被接管。
config.json
config.*.json
BBDown.data
BBDownTV.data
*.data
*.cookie

# ── 下载产物 ──
downloads/

# ── 二进制与构建产物 ──
*.exe
build/
dist/
*.spec

# ── Python（BBDown-Native/tools 下的验证脚本）──
__pycache__/
*.py[cod]
.venv/
venv/

# ── 编辑器 / 系统 ──
.vscode/
.idea/
Thumbs.db
desktop.ini

# ── 开发期残留 ──
.workbuddy/
.devdata/
_shots/
_e2e/
_window.hwnd
*.log
