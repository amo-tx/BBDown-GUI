# ══════════════════════════════════════════════════════════════
#  BBDown-Native —— 纯 Go 原生版
#
#  仓库根目录的 .gitignore 管着通用规则（凭据、*.exe、*.log 等），
#  本文件在更深的层级、优先级更高，用来放行本子目录必须入库的脚本，
#  以及声明本目录独有的开发期产物。
# ══════════════════════════════════════════════════════════════

# ── 凭据 —— 永远不得入库 ──
# 本程序把 config.json 写到 exe 同级目录，即 dist/config.json，
# 里面含有明文的 B 站 SESSDATA / bili_jct 与 TV 端 access_token。
# 下面 dist 的反选规则必须排在它前面，否则会被 `!` 放进来。
config.json
*.json.tmp

# ── 构建产物 ──
# 只保留一个空占位文件，保证 clone 下来就有 dist/（go build -o 不会建目录）。
# 先反选目录本身，再排除全部内容，最后单独放行占位文件。
# 顺序不能乱：git 不允许「父目录被排除时反选其中的文件」。
!dist/
dist/*
!dist/.gitkeep

# ── 开发期数据 ──
# .devdata/：e2e 用的 m4s 样例、WebView2 测试 profile、临时截图
# _shots/  ：GUI 自动化脚本的输出截图
# _e2e/    ：端到端测试的临时构建
.devdata/
_shots/
_e2e/

# ── 根 .gitignore 用 `*.exe` 排除所有可执行文件 ──
# tools/ 里只有脚本，没有二进制；这里反选回来确保验证脚本能入库。
!tools/
!tools/**
